# Non-sensitive runtime configuration only.
# All credentials, webhook tokens, and DB passwords MUST be stored in
# Google Cloud Secret Manager and referenced by Secret ID — never hardcoded here.

GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_AGENT_ENGINE_ID=

# Runtime mode: "production" (uses live GCP services) or "local" (offline evaluation / CI)
SENTINEL_RUNTIME_MODE=production

# Vertex AI Search & Session Persistence
VERTEX_SEARCH_DATASTORE_ID=sentinel-sre-runbooks-ds
SESSION_DB_URL_SECRET_ID=sentinel-session-db-url
PAGERDUTY_INTEGRATION_SECRET_ID=sentinel-pagerduty-routing-key
DEPLOY_CONTROLLER_SECRET_ID=sentinel-deploy-controller-token

# Google Cloud Security & Observability
MODEL_ARMOR_TEMPLATE_ID=projects/your-gcp-project-id/locations/us-central1/templates/sentinel-guardrail-template
DLP_DEIDENTIFY_TEMPLATE_ID=projects/your-gcp-project-id/locations/us-central1/deidentifyTemplates/sentinel-pii-scrubber
OTEL_SERVICE_NAME=sentinel-sre-agent
